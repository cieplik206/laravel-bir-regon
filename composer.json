{
    "name": "cieplik206/laravel-bir-regon",
    "description": "Laravel client for the Polish GUS BIR/REGON API",
    "keywords": [
        "api-client",
        "bir",
        "gus",
        "krs",
        "laravel",
        "nip",
        "poland",
        "regon",
        "soap"
    ],
    "homepage": "https://cieplik206.github.io/laravel-bir-regon/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Paweł Ciepliński",
            "homepage": "https://github.com/cieplik206",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://cieplik206.github.io/laravel-bir-regon/",
        "issues": "https://github.com/cieplik206/laravel-bir-regon/issues",
        "security": "https://github.com/cieplik206/laravel-bir-regon/security/policy",
        "source": "https://github.com/cieplik206/laravel-bir-regon"
    },
    "require": {
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "php": "^8.4",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-data": "^4.14"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "cieplik206\\BirRegon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "cieplik206\\BirRegon\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "cieplik206\\BirRegon\\BirRegonServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:sandbox": "pest --configuration phpunit.sandbox.xml.dist --group=sandbox",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
